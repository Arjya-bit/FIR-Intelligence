# Copy to .env and fill in. Every value is optional — with none of them set the
# service starts on an in-memory store and answers from the rule-based engine.
#
#   cp .env.example .env

# ── IBM watsonx.ai (optional) ─────────────────────────────────────────────
# Without these, crime classification uses the keyword classifier and chat /
# reports are generated deterministically from the analysed corpus.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL=ibm/granite-3-8b-instruct
WATSONX_TIMEOUT=60

# ── Storage (optional) ────────────────────────────────────────────────────
# FIR_STORAGE: auto (default — use MongoDB if reachable, else in-memory),
#              memory (always in-memory), mongodb (fail if unreachable).
FIR_STORAGE=auto
MONGO_URL=mongodb://localhost:27017
MONGO_DB=fir_intelligence
MONGO_TIMEOUT_MS=2000

# ── Server ────────────────────────────────────────────────────────────────
FIR_HOST=127.0.0.1
FIR_PORT=8000
FIR_RELOAD=false

# Comma-separated allowed origins. Leave empty to allow any origin without
# credentials; set it to serve a browser client from another host with cookies.
FIR_CORS_ORIGINS=

# ── Analysis tuning ───────────────────────────────────────────────────────
# How many NCRB-shaped FIRs to seed on first boot.
FIR_SEED_SIZE=100
# Token-similarity score (0-100) above which two names become candidates for
# the same identity. Raising it makes offender linking stricter.
FIR_NAME_MATCH_THRESHOLD=82
# Concurrent watsonx.ai classification calls during batch analysis.
FIR_CLASSIFY_CONCURRENCY=8
# Maximum accepted upload size in bytes (default 8 MB).
FIR_MAX_UPLOAD_BYTES=8388608
