# Copy to .env and fill in. Every value is optional — with none of them set the
# service starts on an in-memory store and answers from the rule-based engine.
#
#   cp .env.example .env

# ── Z.ai / GLM — primary LLM (optional) ───────────────────────────────────
# Powers the assistant and the live intelligence report. Get a key at
# https://z.ai (mainland China: https://open.bigmodel.cn).
# The endpoint is OpenAI-compatible, so LLM_BASE_URL can point at any
# compatible service instead.
ZAI_API_KEY=
LLM_BASE_URL=https://api.z.ai/api/paas/v4
LLM_MODEL=glm-4.6
LLM_PROVIDER_LABEL=Z.ai GLM
LLM_TIMEOUT=90
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.25
# GLM-4.5+ reasoning mode. Noticeably slower; off by default.
LLM_THINKING=false

# Mainland-China endpoint:
#   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ── IBM watsonx.ai (optional, secondary) ──────────────────────────────────
# Used for chat and reports only when no Z.ai key is set. Always used for
# crime-type classification when configured.
# Without either provider, chat and reports are generated deterministically
# from the analysed corpus — computed, never invented.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL=ibm/granite-3-8b-instruct
WATSONX_TIMEOUT=60

# ── Storage (optional) ────────────────────────────────────────────────────
# FIR_STORAGE: auto (default — use MongoDB if reachable, else in-memory),
#              memory (always in-memory), mongodb (fail if unreachable).
FIR_STORAGE=auto
MONGO_URL=mongodb://localhost:27017
MONGO_DB=fir_intelligence
MONGO_TIMEOUT_MS=2000

# ── Server ────────────────────────────────────────────────────────────────
FIR_HOST=127.0.0.1
FIR_PORT=8000
FIR_RELOAD=false

# Comma-separated allowed origins. Leave empty to allow any origin without
# credentials; set it to serve a browser client from another host with cookies.
FIR_CORS_ORIGINS=

# ── Analysis tuning ───────────────────────────────────────────────────────
# How many NCRB-shaped FIRs to seed on first boot.
FIR_SEED_SIZE=100
# Token-similarity score (0-100) above which two names become candidates for
# the same identity. Raising it makes offender linking stricter.
FIR_NAME_MATCH_THRESHOLD=82
# Concurrent watsonx.ai classification calls during batch analysis.
FIR_CLASSIFY_CONCURRENCY=8
# Maximum accepted upload size in bytes (default 8 MB).
FIR_MAX_UPLOAD_BYTES=8388608
